{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fratty-pipeline",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ADMISSION_ROOM", "class_name": "AdmissionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdmissionRoom"] }]
}
